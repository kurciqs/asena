    },
    {
      "id": "headaudio",
      "label": "HeadAudio · MFCC classifier",
      "notes": "Upstream model and processor run offline; 15 source visemes projected onto Asena. Source frame-centre timestamps are retained; live buffering is not measured."
    },
    {
      "id": "wawa",
      "label": "Wawa · frequency heuristic",
      "notes": "Upstream Wawa algorithm on emulated Web Audio spectra. 2048 FFT, default smoothing, 60fps analysis."
    },
    {
      "id": "frequency",
      "label": "lipsync-engine · frequency bands",
      "notes": "Upstream FrequencyAnalyzer on emulated Web Audio inputs. 256 FFT, default controls. Its separate A–F alphabet is not used."
    },
    {
      "id": "amplitude",
      "label": "Amplitude only · simple control",
      "notes": "Energy opens one vowel. Included to reveal timing versus articulation; it cannot distinguish sounds."
    },
    {
      "id": "lam",
      "label": "LAM · neural continuous weights",
      "notes": "One-second fixed ONNX windows, 500ms hop, overlapped predictions. Provisional 52-channel-to-VRoid adapter; eye and brow coefficients are excluded."
    }
