# Documentation template. Export selected values in your shell; no dotenv loader.
# Safe default: opening the website cannot contact model services in replay mode.
ASENA_MODE=replay
ASENA_HOST=127.0.0.1
ASENA_PORT=3001
ASENA_CHAT_MODEL=qwen3.5-2b
ASENA_LMS_API=http://127.0.0.1:1234/v1/chat/completions
ASENA_KOKORO_API=http://127.0.0.1:8880/dev/captioned_speech
ASENA_VOICE=af_heart
ASENA_LIP_SYNC=rhubarb
ASENA_CONTEXT_CAPACITY=8192
ASENA_OUTPUT_RESERVE=512
ASENA_PROFILE_BUDGET=4096
ASENA_MEMORY_BUDGET=1024
ASENA_CONNECT_TIMEOUT=3
ASENA_READ_TIMEOUT=30
ASENA_SERVICE_DEADLINE=90
ASENA_ALIGNMENT_TIMEOUT=30
ASENA_RHUBARB_THREADS=2
ASENA_ALIGNMENT_CACHE_ENTRIES=64
# Defaults resolve relative to the repository, independently of launch directory.
# ASENA_DATA_DIR=/absolute/private/asena-data
# A checksum-verified project-local ARM64 build is preferred when installed.
# Override to choose another executable, including the original Intel build.
# ASENA_RHUBARB=/absolute/path/to/rhubarb
# ASENA_FFMPEG=/absolute/path/to/ffmpeg

# Named speech timings shared by the companion and diagnostic viewer.
# Profiles are defined in speech_profiles.json; selection starts no services.
ASENA_SPEECH_PROFILE=stable-122
# Streaming stays opt-in. Configure live mode/provider separately when prepared.
ASENA_SPEECH_STREAMING=0
# Scripted main chat, LLM blocked by the server. Defaults to saved PCM/cues.
# ASENA_MODE=preview
# ASENA_SPEECH_SOURCE=recorded
# To audition the same scenes with an already authorized running Kokoro:
# ASENA_SPEECH_SOURCE=kokoro
# Or keep saved speech as default and offer live speech in the preview selector:
# ASENA_PREVIEW_KOKORO=1
